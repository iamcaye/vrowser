include("${CMAKE_CURRENT_LIST_DIR}/cef_version.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/DownloadCEF.cmake")

if(NOT DEFINED PROJECT_ARCH)
  if(APPLE)
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
      set(PROJECT_ARCH "arm64")
    else()
      set(PROJECT_ARCH "x86_64")
    endif()
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
      set(PROJECT_ARCH "arm64")
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm")
      set(PROJECT_ARCH "arm")
    else()
      set(PROJECT_ARCH "x86_64")
    endif()
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
      set(PROJECT_ARCH "arm64")
    else()
      set(PROJECT_ARCH "x86_64")
    endif()
  endif()
endif()

if(APPLE)
  if(PROJECT_ARCH STREQUAL "arm64")
    set(VROWSER_CEF_PLATFORM "macosarm64")
  else()
    set(VROWSER_CEF_PLATFORM "macosx64")
  endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(PROJECT_ARCH STREQUAL "arm64")
    set(VROWSER_CEF_PLATFORM "linuxarm64")
  elseif(PROJECT_ARCH STREQUAL "arm")
    set(VROWSER_CEF_PLATFORM "linuxarm")
  else()
    set(VROWSER_CEF_PLATFORM "linux64")
  endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  if(PROJECT_ARCH STREQUAL "arm64")
    set(VROWSER_CEF_PLATFORM "windowsarm64")
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(VROWSER_CEF_PLATFORM "windows32")
  else()
    set(VROWSER_CEF_PLATFORM "windows64")
  endif()
else()
  message(FATAL_ERROR "Unsupported system for the CEF desktop shell")
endif()

vrowser_download_cef(
  "${VROWSER_CEF_PLATFORM}"
  "${VROWSER_CEF_VERSION}"
  "${VROWSER_CEF_CHANNEL}"
  "${CMAKE_SOURCE_DIR}/third_party/cef")

list(APPEND CMAKE_MODULE_PATH "${CEF_ROOT}/cmake")
find_package(CEF REQUIRED)

add_subdirectory("${CEF_LIBCEF_DLL_WRAPPER_PATH}" libcef_dll_wrapper)
